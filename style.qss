QWidget { background-color: #f4f6fb; font-family: Segoe UI; font-size: 15px; color: #1f2a44; }
QLabel#title { font-size: 26px; font-weight: bold; color: #2b4c8c; }
QPushButton { background-color: #2b4c8c; color: white; border-radius: 8px; font-weight: bold; }
QPushButton:hover { background-color: #3d64b0; }
QLineEdit { background-color: white; border: 1px solid #b8c2d9; border-radius: 6px; padding: 0px 10px; }
QTableWidget { background-color: white; alternate-background-color: #eef1f6; border: 1px solid #b8c2d9; border-radius: 6px; gridline-color: #e1e6f0; }
QHeaderView::section { background-color: #dfe6f5; color: #2b4c8c; font-weight: bold; border: none; padding: 6px; }